{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:torrentng:schema:transfer-qualification-v1",
  "title": "TorrentNG transfer rebuild qualification record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_commit",
    "status",
    "checks",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "transfer-qualification-v1" },
    "kind": {
      "enum": [
        "transfer-live-parity-v1",
        "transfer-storage-qualification-v1",
        "transfer-recovery-qualification-v1",
        "transfer-gate-policy-v1",
        "transfer-simulator-qualification-v1",
        "transfer-performance-policy-v1",
        "transfer-soak-qualification-v1",
        "transfer-canary-qualification-v1",
        "transfer-independent-review-v1",
        "transfer-release-bundle-v1",
        "transfer-catalog-load-v1"
      ]
    },
    "source_commit": { "$ref": "#/$defs/git_sha" },
    "status": { "enum": ["passed", "blocked"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "notes": { "type": "string", "maxLength": 8192 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence_sha256s"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "not_run"] },
        "evidence_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  }
}
