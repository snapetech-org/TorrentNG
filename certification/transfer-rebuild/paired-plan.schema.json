{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:torrentng:schema:transfer-paired-plan-v1",
  "title": "TorrentNG randomized paired trial plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "catalog_sha256", "pins_sha256",
    "repetitions", "seed", "schedule_algorithm", "catalog",
    "pinned_client_ids", "excluded_cases", "excluded_pairs", "schedule"
  ],
  "properties": {
    "schema_version": { "const": "transfer-paired-plan-v1" },
    "plan_id": { "type": "string", "pattern": "^[a-f0-9]{20}$" },
    "catalog_sha256": { "$ref": "#/$defs/sha256" },
    "pins_sha256": { "$ref": "#/$defs/sha256" },
    "repetitions": { "type": "integer", "minimum": 1, "maximum": 100 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "schedule_algorithm": { "const": "sha256-fisher-yates-v1" },
    "catalog": { "$ref": "#/$defs/catalog" },
    "pinned_client_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/client_id" }
    },
    "excluded_cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/excluded_case" }
    },
    "excluded_pairs": {
      "type": "array",
      "items": { "$ref": "#/$defs/excluded_pair" }
    },
    "schedule": {
      "type": "array",
      "items": { "$ref": "#/$defs/trial_slot" }
    },
    "profile_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/profile_id" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "client_id": {
      "enum": ["deluge", "qbittorrent", "rtorrent", "torrentngd", "transmission", "rqbit", "urtorrent"]
    },
    "profile_id": {
      "enum": ["G3/hybrid-padding", "G3/v2-piece-layer", "N1/lan_1g", "N1/lan_10g"]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "client_ids", "profile_ids", "profiles_sha256", "cases", "catalog_sha256"],
      "properties": {
        "schema_version": { "const": "transfer-workload-catalog-v1" },
        "client_ids": {
          "type": "array",
          "const": ["deluge", "qbittorrent", "rtorrent", "torrentngd", "transmission", "rqbit", "urtorrent"]
        },
        "profile_ids": {
          "type": "array",
          "const": ["G3/hybrid-padding", "G3/v2-piece-layer", "N1/lan_1g", "N1/lan_10g"]
        },
        "profiles_sha256": { "$ref": "#/$defs/sha256" },
        "catalog_sha256": { "$ref": "#/$defs/sha256" },
        "cases": {
          "type": "array",
          "minItems": 28,
          "maxItems": 28,
          "items": { "$ref": "#/$defs/case" }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "client_id", "profile_id", "kind", "protocol", "expected_payload_bytes", "piece_length", "applicability", "applicability_reason"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "client_id": { "$ref": "#/$defs/client_id" },
        "profile_id": { "$ref": "#/$defs/profile_id" },
        "kind": { "const": "download" },
        "protocol": { "enum": ["v1", "v2", "hybrid"] },
        "expected_payload_bytes": { "type": "integer", "minimum": 0 },
        "piece_length": { "type": "integer", "minimum": 16384, "maximum": 16777216 },
        "applicability": { "enum": ["candidate", "unsupported"] },
        "applicability_reason": { "type": ["string", "null"] }
      }
    },
    "excluded_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "reason"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "excluded_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "repetition", "reason"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/profile_id" },
        "repetition": { "type": "integer", "minimum": 1, "maximum": 100 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "trial_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_index", "pair_order", "order_in_pair", "trial_id", "pair_id", "attempt", "repetition", "case_id", "client_id", "profile_id"],
      "properties": {
        "execution_index": { "type": "integer", "minimum": 1 },
        "pair_order": { "type": "integer", "minimum": 1, "maximum": 400 },
        "order_in_pair": { "type": "integer", "minimum": 1, "maximum": 7 },
        "trial_id": { "type": "string", "minLength": 1 },
        "pair_id": { "type": "string", "minLength": 1 },
        "attempt": { "const": 1 },
        "repetition": { "type": "integer", "minimum": 1, "maximum": 100 },
        "case_id": { "type": "string", "minLength": 1 },
        "client_id": { "$ref": "#/$defs/client_id" },
        "profile_id": { "$ref": "#/$defs/profile_id" }
      }
    }
  }
}
