{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:torrentng:schema:transfer-scorecard-v1",
  "title": "TorrentNG descriptive paired transfer scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "manifest_sha256", "manifest_id", "analysis", "groups"],
  "properties": {
    "schema_version": { "const": "transfer-scorecard-v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "confidence_level", "bootstrap_samples", "random_seed", "minimum_paired_release_trials", "performance_thresholds_applied"],
      "properties": {
        "method": { "const": "paired_percentile_bootstrap_median_ratio" },
        "confidence_level": { "const": 0.95 },
        "bootstrap_samples": { "type": "integer", "minimum": 1000, "maximum": 100000 },
        "random_seed": { "type": "integer" },
        "minimum_paired_release_trials": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "performance_thresholds_applied": { "const": false }
      }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metric_name": {
      "type": "string",
      "enum": [
        "goodput_bytes_per_second",
        "rss_peak_bytes",
        "pss_peak_bytes",
        "cgroup_anon_peak_bytes",
        "cgroup_file_peak_bytes",
        "cgroup_reclaimable_cache_peak_bytes",
        "cgroup_current_peak_bytes",
        "threads_peak",
        "fds_peak",
        "block_read_bytes_per_gib",
        "block_write_bytes_per_gib",
        "energy_joules_per_gib",
        "cpu_seconds_per_gib"
      ]
    },
    "metric_value": { "type": ["number", "null"] },
    "pair_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "client_a", "client_b", "ratio_b_over_a"],
      "properties": {
        "pair_id": { "type": "string", "minLength": 1 },
        "client_a": { "type": "number", "exclusiveMinimum": 0 },
        "client_b": { "type": "number", "minimum": 0 },
        "ratio_b_over_a": { "type": "number", "minimum": 0 }
      }
    },
    "metric_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "ratio_b_over_a_median", "ci95_low", "ci95_high", "paired_sample_count", "paired_samples", "minimum_sample_met"],
      "properties": {
        "direction": { "enum": ["higher", "lower"] },
        "ratio_b_over_a_median": { "type": "number", "minimum": 0 },
        "ci95_low": { "type": "number", "minimum": 0 },
        "ci95_high": { "type": "number", "minimum": 0 },
        "paired_sample_count": { "type": "integer", "minimum": 1 },
        "paired_samples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pair_sample" } },
        "minimum_sample_met": { "type": "boolean" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "kind", "protocol", "fixture_sha256", "comparison_signature_sha256", "paired_release_sample_minimum", "valid_pair_count", "excluded_pairs", "clients", "comparisons"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string", "minLength": 1 },
        "fixture_sha256": { "$ref": "#/$defs/sha256" },
        "fixture_sha256s": { "type": "array", "items": { "$ref": "#/$defs/sha256" }, "minItems": 1, "uniqueItems": true },
        "comparison_signature_sha256": { "$ref": "#/$defs/sha256" },
        "paired_release_sample_minimum": { "type": "integer", "minimum": 1 },
        "valid_pair_count": { "type": "integer", "minimum": 0 },
        "excluded_pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pair_id", "reason"],
            "properties": {
              "pair_id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["client_key", "client_id", "version", "paired_trial_count", "metrics_median"],
            "properties": {
              "client_key": { "type": "string", "minLength": 1 },
              "client_id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "paired_trial_count": { "type": "integer", "minimum": 0 },
              "metrics_median": {
                "type": "object",
                "propertyNames": { "$ref": "#/$defs/metric_name" },
                "additionalProperties": { "$ref": "#/$defs/metric_value" }
              }
            }
          }
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["client_a", "client_b", "matched_pair_ids", "metrics"],
            "properties": {
              "client_a": { "type": "string", "minLength": 1 },
              "client_b": { "type": "string", "minLength": 1 },
              "matched_pair_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "metrics": {
                "type": "object",
                "propertyNames": { "$ref": "#/$defs/metric_name" },
                "additionalProperties": { "$ref": "#/$defs/metric_comparison" }
              }
            }
          }
        }
      }
    }
  }
}
