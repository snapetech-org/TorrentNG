{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:torrentng:schema:transfer-manifest-v1",
  "title": "TorrentNG transfer rebuild evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "created_at", "source_commit", "worktree_dirty", "trial_files", "artifacts"],
  "properties": {
    "schema_version": { "const": "transfer-manifest-v1" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "worktree_dirty": { "type": "boolean" },
    "trial_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "trial_id", "pair_id", "outcome"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "trial_id": { "type": "string", "minLength": 1 },
          "pair_id": { "type": "string", "minLength": 1 },
          "outcome": { "enum": ["complete", "incomplete", "invalid", "failed", "unmeasured"] }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "kind": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "anyOf": [
    { "properties": { "trial_files": { "minItems": 1 } } },
    { "properties": { "artifacts": { "minItems": 1 } } }
  ]
}
