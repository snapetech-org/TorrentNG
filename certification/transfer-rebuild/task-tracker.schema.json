{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:torrentng:schema:transfer-task-tracker-v1",
  "title": "TorrentNG paired-trial private tracker snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "topology_sha256", "gateway", "target_address",
    "target_port", "target_peer_id_sha256", "target_ready", "seed_address",
    "seed_port", "seed_peer_id_sha256", "seed_ready", "info_hashes_sha256",
    "announce_counts", "request_count", "artifact_sha256"
  ],
  "properties": {
    "schema_version": { "const": "transfer-task-tracker-v1" },
    "topology_sha256": { "$ref": "#/$defs/sha256" },
    "gateway": { "type": "string", "format": "ipv4" },
    "target_address": { "type": "string", "format": "ipv4" },
    "target_port": { "anyOf": [{ "$ref": "#/$defs/port" }, { "type": "null" }] },
    "target_peer_id_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "target_ready": { "type": "boolean" },
    "seed_address": { "type": "string", "format": "ipv4" },
    "seed_port": { "anyOf": [{ "$ref": "#/$defs/port" }, { "type": "null" }] },
    "seed_peer_id_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "seed_ready": { "type": "boolean" },
    "info_hashes_sha256": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "announce_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["started", "completed", "stopped", "other"],
      "properties": {
        "started": { "$ref": "#/$defs/count" },
        "completed": { "$ref": "#/$defs/count" },
        "stopped": { "$ref": "#/$defs/count" },
        "other": { "$ref": "#/$defs/count" }
      }
    },
    "request_count": { "$ref": "#/$defs/count" },
    "artifact_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
  }
}
