+/// Consume a requested range from every cached window for one file.
+fn consume_peer_read_entries(
+    entries: &mut Vec<PeerReadCacheEntry>,
+    identity: FileIdentity,
+    offset: u64,
+    len: usize,
+) -> (usize, usize) {
+    if len == 0 {
+        return (0, 0);
+    }
+    let mut removed = 0;
+    let mut removed_bytes = 0;
+    entries.retain_mut(|entry| {
+        if entry.identity != identity || entry.consume(offset, len) {
+            removed += 1;
+            removed_bytes += entry.data.len();
+            false
+        } else {
+            true
+        }
+    });
+    (removed, removed_bytes)
+}
+
 const MAX_GLOBAL_PEER_READ_CACHE_BYTES: u64 = 16 * 1024 * 1024;
 
