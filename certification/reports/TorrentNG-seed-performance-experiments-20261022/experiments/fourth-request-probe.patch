+fn observe_upload_pipeline_width(
+    current: usize,
+    observed: usize,
+    probe_expanded: bool,
+) -> (usize, bool) {
+    let maximum = MAX_READY_UPLOAD_INTAKE_MESSAGES;
+    let observed = observed.min(maximum);
+    let mut width = current.max(observed);
+    let mut probe_expanded = probe_expanded;
+    if !probe_expanded && observed == maximum.saturating_sub(1) && width < maximum {
+        // A three-request burst is common on TCP even when the peer has a
+        // larger request window. Leave one bounded slot for a fourth request
+        // so the storage batch can reach its existing four-block limit.
+        width = maximum;
+        probe_expanded = true;
+    }
+    (width, probe_expanded)
