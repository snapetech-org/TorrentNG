@@ -10959,0 +10951,48 @@ mod tests {
+    #[tokio::test]
+    async fn raw_piece_writes_follow_flushed_control_messages() {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let remote_stream = TcpStream::connect(listener.local_addr().unwrap())
+            .await
+            .unwrap();
+        let (server_stream, _) = listener.accept().await.unwrap();
+        let mut outgoing = PeerIo::Tcp(Framed::new(server_stream, PeerCodec::default()));
+        let mut incoming = Framed::new(remote_stream, PeerCodec::default());
+
+        outgoing.send(Message::Unchoke).await.unwrap();
+        outgoing
+            .send_piece(7, 0, bytes::Bytes::from_static(b"first"))
+            .await
+            .unwrap();
+        outgoing.send(Message::Choke).await.unwrap();
+        let second = bytes::Bytes::from_static(b"second");
+        let third = bytes::Bytes::from_static(b"third");
+        assert_eq!(
+            outgoing
+                .send_pieces(&[(7, 5, &second), (8, 0, &third)])
+                .await
+                .unwrap(),
+            2
+        );
+
+        assert!(matches!(
+            incoming.next().await.unwrap().unwrap(),
+            Message::Unchoke
+        ));
+        assert!(matches!(
+            incoming.next().await.unwrap().unwrap(),
+            Message::Piece { piece: 7, begin: 0, data } if data == bytes::Bytes::from_static(b"first")
+        ));
+        assert!(matches!(
+            incoming.next().await.unwrap().unwrap(),
+            Message::Choke
+        ));
+        assert!(matches!(
+            incoming.next().await.unwrap().unwrap(),
+            Message::Piece { piece: 7, begin: 5, data } if data == second
+        ));
+        assert!(matches!(
+            incoming.next().await.unwrap().unwrap(),
+            Message::Piece { piece: 8, begin: 0, data } if data == third
+        ));
+    }
+
