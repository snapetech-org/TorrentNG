+    #[tokio::test(start_paused = true)]
+    async fn immediate_upload_batch_grants_keep_individual_settlement_and_refunds() {
+        const BLOCK: u64 = 16 * 1024;
+        let budget = GlobalNetworkBudget::new(1, None, Some(640 * 1024));
+        let torrent = budget.new_transfer_torrent_key();
+        budget.register_upload_torrent(torrent, None);
+        let peer = rate_peer(torrent, 1);
+        budget.register_transfer_peer(peer);
+        let demand_change_count = budget.upload_tree.demand_changes.lock().unwrap().len();
+        let cancellation = RateLimitCancellation::default();
+        let generation = cancellation.generation();
+        let payloads = [BLOCK; 4];
+
+        let grants = budget
+            .acquire_upload_batch(peer, &payloads, &cancellation, generation)
+            .await
+            .unwrap();
+        assert_eq!(grants.len(), payloads.len());
+        assert!(grants.iter().all(Option::is_some));
+        assert_eq!(budget.upload_tree.next_demand.load(Ordering::Relaxed), 1);
+        assert_eq!(
+            budget.upload_tree.demand_changes.lock().unwrap().len(),
+            demand_change_count
+        );
+        assert_eq!(budget.upload_tree.available_credit_bytes(peer), 0);
+
+        drop(grants);
+        assert_eq!(budget.upload_tree.available_credit_bytes(peer), 64 * 1024);
+
+        let grants = budget
+            .acquire_upload_batch(peer, &payloads, &cancellation, generation)
+            .await
+            .unwrap();
+        for grant in grants.into_iter().flatten() {
+            grant.settle(BLOCK);
+        }
+        assert_eq!(budget.upload_tree.available_credit_bytes(peer), 0);
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn rate_limited_upload_batch_keeps_grants_before_cancellation() {
+        const BLOCK: u64 = 16 * 1024;
+        let budget = GlobalNetworkBudget::new(1, None, Some(1));
+        let torrent = budget.new_transfer_torrent_key();
+        budget.register_upload_torrent(torrent, None);
+        let peer = rate_peer(torrent, 1);
+        budget.register_transfer_peer(peer);
+        let cancellation = RateLimitCancellation::default();
+        let generation = cancellation.generation();
+        let task_budget = budget.clone();
+        let task_cancellation = cancellation.clone();
+        let waiter = tokio::spawn(async move {
+            task_budget
+                .acquire_upload_batch(peer, &[BLOCK; 4], &task_cancellation, generation)
+                .await
+        });
+
+        tokio::task::yield_now().await;
+        tokio::task::yield_now().await;
+        assert!(
+            !waiter.is_finished(),
+            "the remaining grants should be rate limited"
+        );
+        cancellation.cancel();
+        let grants = waiter.await.unwrap().unwrap();
+        assert_eq!(grants.len(), 4);
+        assert!(grants[..2].iter().all(Option::is_some));
+        assert!(grants[2..].iter().all(Option::is_none));
+
+        drop(grants);
+        assert_eq!(budget.upload_tree.available_credit_bytes(peer), 16 * 1024);
+    }
