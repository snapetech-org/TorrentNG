+    /// Reserve a bounded group of upload payload grants under one rate-tree
+    /// lock when they are immediately available. A rate-limited remainder
+    /// falls back to the normal per-payload waiter path, preserving the same
+    /// fairness, cancellation, and settlement boundaries as individual
+    /// admissions.
+    pub(crate) async fn acquire_upload_batch(
+        &self,
+        peer_id: RatePeerId,
+        payload_bytes: &[u64],
+        cancellation: &RateLimitCancellation,
+        generation: u64,
+    ) -> anyhow::Result<SmallVec<[Option<RateAdmissionGrant>; 4]>> {
+        anyhow::ensure!(
+            !payload_bytes.is_empty() && payload_bytes.iter().all(|bytes| *bytes > 0),
+            "upload rate batch must contain non-zero payloads"
+        );
+
+        let mut grants = SmallVec::new();
+        if cancellation.generation() != generation {
+            grants.extend(std::iter::repeat_with(|| None).take(payload_bytes.len()));
+            return Ok(grants);
+        }
+
+        let now = self.upload_tree.now();
+        let (grant_ids, granted_count, wake_fairness_waiters, unknown_peer) = {
+            let mut tree = self.upload_tree.lock_tree();
+            let mut grant_ids = SmallVec::<[(u64, u64); 4]>::new();
+            let mut granted_count = 0;
+            let mut unknown_peer = false;
+            for &bytes in payload_bytes {
+                match tree.try_grant_probe_tracked(peer_id, bytes, now) {
+                    (Grant::Granted, Some(grant_id)) => {
+                        grant_ids.push((grant_id, bytes));
+                        granted_count += 1;
+                    }
+                    (Grant::Wait { .. }, _) => break,
+                    (Grant::Unknown, _) => {
+                        unknown_peer = true;
+                        break;
+                    }
+                    (Grant::Granted, None) => {
+                        unreachable!("non-zero upload rate grant has no reservation identity")
+                    }
+                }
+            }
+            let wake_fairness_waiters =
+                granted_count > 0 && tree.has_change_waiters(peer_id.torrent);
+            (
+                grant_ids,
+                granted_count,
+                wake_fairness_waiters,
+                unknown_peer,
+            )
+        };
+
+        if wake_fairness_waiters {
+            self.upload_tree.notify_demand_change(peer_id.torrent);
+        }
+        grants.extend(grant_ids.into_iter().map(|(grant_id, bytes)| {
+            Some(RateAdmissionGrant {
+                scheduler: Arc::clone(&self.upload_tree),
+                peer_id,
+                grant_id,
+                bytes,
+                active: true,
+            })
+        }));
+        if unknown_peer {
+            anyhow::bail!(
+                "rate peer is not registered: torrent={} connection={}.{}",
+                peer_id.torrent.0,
+                peer_id.connection.slot,
+                peer_id.connection.generation
+            );
+        }
+
+        if cancellation.generation() != generation {
+            grants.clear();
+            grants.extend(std::iter::repeat_with(|| None).take(payload_bytes.len()));
+            return Ok(grants);
+        }
+
+        for &bytes in &payload_bytes[granted_count..] {
+            match self
+                .acquire_upload(peer_id, bytes, cancellation, generation)
+                .await
+            {
+                Ok(Some(grant)) => grants.push(Some(grant)),
+                Ok(None) => {
+                    grants.push(None);
+                    grants.extend(
+                        std::iter::repeat_with(|| None)
+                            .take(payload_bytes.len().saturating_sub(grants.len())),
+                    );
+                    break;
+                }
+                Err(error) => return Err(error),
+            }
+        }
+        Ok(grants)
+    }
