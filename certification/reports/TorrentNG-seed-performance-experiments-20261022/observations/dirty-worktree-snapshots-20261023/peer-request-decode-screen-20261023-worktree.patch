+        buf.put_u8(6);
+        buf.put_u32(23);
+        buf.put_u32(32_768);
+        buf.put_u32(0);
+
+        assert!(matches!(
+            PeerCodec::default().decode(&mut buf),
+            Err(WireError::InvalidMessage(_))
+        ));
+        assert!(buf.is_empty());
+    }
