+async fn send_mapped_file_range_frames(
+    stream: &mut TcpStream,
+    blocks: &[(UploadRequest, LeasedUploadBlock)],
+    range_offset: u64,
+    mapping: &MappedFileRange,
+) -> Result<usize, (usize, std::io::Error)> {
+    use std::os::fd::AsRawFd;
+    use tokio::io::Interest;
+
+    if blocks.is_empty() || blocks.len() > MAX_UPLOAD_READ_BATCH_BLOCKS {
+        return Err((
+            0,
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "mapped Piece frame group exceeds its bound",
+            ),
+        ));
+    }
+
+    let mut headers = [[0u8; 13]; MAX_UPLOAD_READ_BATCH_BLOCKS];
+    let mut cursors = [(0usize, 0usize); MAX_UPLOAD_READ_BATCH_BLOCKS];
+    for (index, (request, block)) in blocks.iter().enumerate() {
+        let Some(range) = block.file_range else {
+            return Err((
+                0,
+                std::io::Error::new(
+                    std::io::ErrorKind::InvalidInput,
+                    "mapped Piece frame lacks a file range",
+                ),
+            ));
+        };
+        let header = piece_frame_header(request.wire_piece, request.wire_begin, range.length)
+            .map_err(|error| {
+                (
+                    0,
+                    std::io::Error::new(std::io::ErrorKind::InvalidInput, error.to_string()),
+                )
+            })?;
+        headers[index] = header;
+        let relative = range.offset.checked_sub(range_offset).ok_or_else(|| {
+            (
+                0,
+                std::io::Error::new(
+                    std::io::ErrorKind::InvalidInput,
+                    "mapped Piece range precedes its mapping",
+                ),
+            )
+        })?;
+        let relative = usize::try_from(relative).map_err(|_| {
+            (
+                0,
+                std::io::Error::new(
+                    std::io::ErrorKind::InvalidInput,
+                    "mapped Piece offset exceeds usize",
+                ),
+            )
+        })?;
+        if relative
+            .checked_add(range.length)
+            .is_none_or(|end| end > mapping.len())
+        {
+            return Err((
+                0,
+                std::io::Error::new(
+                    std::io::ErrorKind::InvalidInput,
+                    "mapped Piece range exceeds its mapping",
+                ),
+            ));
+        }
+    }
+
+    let fd = stream.as_raw_fd();
+    loop {
+        let completed = blocks
+            .iter()
+            .enumerate()
+            .take_while(|(index, (_, block))| {
+                let length = block.file_range.map_or(0, |range| range.length);
+                cursors[*index].0 == headers[*index].len() && cursors[*index].1 == length
+            })
+            .count();
+        if completed == blocks.len() {
+            return Ok(completed);
+        }
+
+        let write_result = {
+            let mut iovecs: [libc::iovec; MAX_UPLOAD_READ_BATCH_BLOCKS * 2] =
+                std::array::from_fn(|_| libc::iovec {
+                    iov_base: std::ptr::null_mut(),
+                    iov_len: 0,
+                });
+            let mut iovec_count = 0usize;
+            for (index, (_, block)) in blocks.iter().enumerate().skip(completed) {
+                let range = block.file_range.expect("mapped group checked above");
+                let (header_offset, payload_offset) = cursors[index];
+                if header_offset < headers[index].len() {
+                    iovecs[iovec_count] = libc::iovec {
+                        iov_base: headers[index][header_offset..].as_ptr() as *mut libc::c_void,
+                        iov_len: headers[index].len() - header_offset,
+                    };
+                    iovec_count += 1;
+                }
+                if payload_offset < range.length {
+                    let relative = usize::try_from(range.offset - range_offset)
+                        .expect("mapped group offset checked above");
+                    let pointer = mapping
+                        .pointer_at(relative + payload_offset)
+                        .expect("mapped payload offset checked above");
+                    iovecs[iovec_count] = libc::iovec {
+                        iov_base: pointer as *mut libc::c_void,
+                        iov_len: range.length - payload_offset,
+                    };
+                    iovec_count += 1;
+                }
+            }
+
+            // SAFETY: the iovecs and their header storage live through this syscall.
+            // Payload pointers belong to mapping, retained for the entire function.
+            // No Rust slice or reference is formed over mmap data.
+            let mut message: libc::msghdr = unsafe { std::mem::zeroed() };
+            message.msg_iov = iovecs.as_mut_ptr();
+            message.msg_iovlen = iovec_count;
+            stream.try_io(Interest::WRITABLE, || {
+                // SAFETY: fd is the live nonblocking TcpStream; each iovec refers to
+                // live header storage or a retained read-only mapping, consumed only
+                // for this synchronous sendmsg call.
+                let sent =
+                    unsafe { libc::sendmsg(fd, &message, libc::MSG_DONTWAIT | libc::MSG_NOSIGNAL) };
+                if sent < 0 {
+                    Err(std::io::Error::last_os_error())
+                } else {
+                    Ok(sent as usize)
+                }
+            })
+        };
+        match write_result {
+            Ok(0) => {
+                return Err((
+                    completed,
+                    std::io::Error::new(
+                        std::io::ErrorKind::WriteZero,
+                        "mapped Piece send made no progress",
+                    ),
+                ));
+            }
+            Ok(sent) => {
+                let mut remaining = sent;
+                for (index, (_, block)) in blocks.iter().enumerate().skip(completed) {
+                    if remaining == 0 {
+                        break;
+                    }
+                    let range = block.file_range.expect("mapped group checked above");
+                    let header_remaining = headers[index].len() - cursors[index].0;
+                    let header_sent = remaining.min(header_remaining);
+                    cursors[index].0 += header_sent;
+                    remaining -= header_sent;
+                    let payload_remaining = range.length - cursors[index].1;
+                    let payload_sent = remaining.min(payload_remaining);
+                    cursors[index].1 += payload_sent;
+                    remaining -= payload_sent;
+                }
+                if remaining != 0 {
+                    return Err((
+                        completed,
+                        std::io::Error::new(
+                            std::io::ErrorKind::InvalidData,
+                            "sendmsg reported more bytes than the mapped iovecs",
+                        ),
+                    ));
+                }
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                if let Err(error) = stream.writable().await {
+                    return Err((completed, error));
+                }
+            }
+            Err(error) => return Err((completed, error)),
+        }
+    }
+}
