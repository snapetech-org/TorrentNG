+/// One bounded nonblocking file-to-socket operation on Linux.
+/// A bounded read-only file mapping held across a direct TCP write.
+///
+/// The payload is exposed only as a raw pointer for a synchronous `sendmsg`
+/// call. Callers must not construct Rust references from it: another process
+/// can modify or truncate the backing file outside TorrentNG's storage locks.
+#[cfg(target_os = "linux")]
+#[derive(Debug)]
+pub struct MappedFileRange {
+    base: usize,
+    mapped_len: usize,
+    window_offset: u64,
+    length: usize,
+    file: Arc<OpenFile>,
+    _budget: OwnedSemaphorePermit,
+}
+
+#[cfg(target_os = "linux")]
+const MAPPED_UPLOAD_WINDOW_BYTES: u64 = 1024 * 1024;
+
+#[cfg(target_os = "linux")]
+static MAPPED_UPLOAD_WINDOW_BUDGET: Lazy<Arc<Semaphore>> =
+    Lazy::new(|| Arc::new(Semaphore::new(1)));
+
+#[cfg(target_os = "linux")]
+static MAPPED_UPLOAD_WINDOW_CACHE: Lazy<Mutex<VecDeque<(PathBuf, u64, Arc<MappedFileRange>)>>> =
+    Lazy::new(|| Mutex::new(VecDeque::with_capacity(1)));
+
+#[cfg(target_os = "linux")]
+impl MappedFileRange {
+    pub fn len(&self) -> usize {
+        self.length
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.length == 0
+    }
+
+    pub fn window_offset(&self) -> u64 {
+        self.window_offset
+    }
+
+    pub fn covers_file_range(&self, offset: u64, length: usize) -> bool {
+        let Ok(length) = u64::try_from(length) else {
+            return false;
+        };
+        let Some(end) = offset.checked_add(length) else {
+            return false;
+        };
+        let Some(window_end) = self.window_offset.checked_add(self.length as u64) else {
+            return false;
+        };
+        offset >= self.window_offset && end <= window_end
+    }
+
+    /// Return a raw pointer into the mapped window at a window-relative byte
+    /// offset. The pointer is valid only while `self` remains alive and must
+    /// be used synchronously without creating a Rust reference.
+    pub fn pointer_at(&self, offset: usize) -> Option<*const u8> {
+        if offset >= self.length {
+            return None;
+        }
+        self.base
+            .checked_add(offset)
+            .map(|address| address as *const u8)
+    }
+
+    pub fn matches_current_path(&self, path: &Path) -> io::Result<bool> {
+        self.file.matches_current_path(path)
+    }
+}
+
+#[cfg(target_os = "linux")]
+impl Drop for MappedFileRange {
+    fn drop(&mut self) {
+        // SAFETY: `base` and `mapped_len` are the exact successful mmap pair
+        // created by `map_file_range_lease`, and this owner unmaps them once.
+        unsafe {
+            libc::munmap(self.base as *mut libc::c_void, self.mapped_len);
+        }
+    }
+}
