+        instance.seed_source_override.write_bytes(b"verified private seed fixture" * 100)
+        instance.seed_sha256_override = hashlib.sha256(instance.seed_source_override.read_bytes()).hexdigest()
+        return instance
+
+    def test_local_metadata_never_uses_the_public_index(self):
+        with tempfile.TemporaryDirectory() as directory:
+            instance = self.fixture(directory)
+            with mock.patch.object(benchmark, "_open_http", side_effect=AssertionError("network lookup")):
+                instance._validate_controlled_seed_source()
+                meta = instance._controlled_seed_metadata("198.18.0.2")
+            self.assertEqual(meta["sha256"], instance.seed_sha256_override)
+            self.assertEqual(meta["size"], instance.seed_source_override.stat().st_size)
+            self.assertTrue(meta["torrent_path"].is_file())
+            self.assertEqual(len(meta["info_hash"]), 40)
+
+    def test_missing_or_mismatched_expected_hash_is_rejected(self):
+        with tempfile.TemporaryDirectory() as directory:
