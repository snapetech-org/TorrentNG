+            for digest in ("", "not-a-sha", "0" * 64):
+                with self.subTest(digest=digest):
+                    instance.seed_sha256_override = digest
+                    with self.assertRaises(RuntimeError):
+                        instance._validate_controlled_seed_source()
+
