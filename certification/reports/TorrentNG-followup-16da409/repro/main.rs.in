#![allow(dead_code)]
use std::sync::{Arc, atomic::{AtomicUsize,Ordering::SeqCst}};
use std::time::Duration;
use rt_storage::{MountScheduler,SchedulerConfig,StorageIoConfig,IoClass};
use rt_path::{StorageProfile,StorageRootId};
use rt_peer_wire::{PeerCodec,Message};
use rt_metrics::{ResourceGovernor,ResourceGovernorConfig,MemoryClass};
use tokio_util::codec::{Decoder,Encoder};
use bytes::BytesMut;

mod coords {
    // The scheduler's identity/coordinate value types, copied without behavior changes.
    pub const BLOCK_SIZE:u32=16*1024;
    #[derive(Debug,Clone,Copy,PartialEq,Eq,Hash,PartialOrd,Ord)]
    pub struct BlockExtent {pub piece:u32,pub begin:u32,pub length:u32}
    impl BlockExtent {pub fn new(piece:u32,begin:u32,length:u32)->Self {Self{piece,begin,length}}}
    #[derive(Debug,Clone,Copy,PartialEq,Eq,Hash,PartialOrd,Ord)]
    pub struct ConnectionId {pub slot:u32,pub generation:u32}
    #[derive(Debug,Clone,Copy,PartialEq,Eq,Hash,PartialOrd,Ord)]
    pub struct TorrentKey(pub u64);
    #[derive(Debug,Clone,Copy,PartialEq,Eq,Hash,PartialOrd,Ord)]
    pub struct TransferPeerId {pub torrent:TorrentKey,pub connection:ConnectionId}
    impl TransferPeerId {pub const fn new(torrent:TorrentKey,connection:ConnectionId)->Self{Self{torrent,connection}}}
}
mod rate {pub type RatePeerId=super::coords::TransferPeerId;}
#[path=@SCHEDULER_SOURCE@]
mod upload_scheduler;

async fn cache_retirement() {
    let path=std::env::temp_dir().join(format!("tng-followup-{}.bin",std::process::id()));
    std::fs::write(&path,b"abcdefghijklmnop").unwrap();
    let scheduler=MountScheduler::new(StorageRootId::new(),&SchedulerConfig{
        profile:StorageProfile::Nvme,
        storage_io:StorageIoConfig{peer_read_readahead_bytes:16,peer_read_readahead_sequential_only:false,peer_read_elevator_budget_ms:0,..Default::default()},
        ..Default::default()
    });
    let first=scheduler.read_at(IoClass::PeerRead,&path,0,4).await.unwrap();
    let tail=scheduler.read_at(IoClass::PeerRead,&path,12,4).await.unwrap();
    let after_tail=scheduler.stats();
    let middle=scheduler.read_at(IoClass::PeerRead,&path,4,8).await.unwrap();
    let after=scheduler.stats();
    assert_eq!(&first[..],b"abcd");assert_eq!(&tail[..],b"mnop");assert_eq!(&middle[..],b"efghijkl");
    println!("CACHE: tail-first entries={} backend_reads_before_middle={} backend_reads_after_middle={} hits={} misses={}",after_tail.peer_read_cache_entries,after_tail.backend_read_ops_by_class.iter().sum::<u64>(),after.backend_read_ops_by_class.iter().sum::<u64>(),after.peer_read_cache_hits,after.peer_read_cache_misses);
    assert_eq!(after_tail.peer_read_cache_entries,0);
    assert_eq!(after.backend_read_ops_by_class.iter().sum::<u64>(),2);
    std::fs::remove_file(path).unwrap();
}

async fn admission_hold_and_wait() {
    use coords::*;
    use upload_scheduler::*;
    let scheduler=UploadReadScheduler::new(UploadReadLimits::default());
    let peers:Vec<_>=(0..64).map(|slot|TransferPeerId::new(TorrentKey(1),ConnectionId{slot,generation:1})).collect();
    let mut old_permits=Vec::new();
    for peer in &peers {scheduler.register(*peer).unwrap();old_permits.push(scheduler.acquire(*peer,BlockExtent::new(0,0,BLOCK_SIZE)).await.unwrap());}
    let started=Arc::new(AtomicUsize::new(0));let first=Arc::new(AtomicUsize::new(0));let completed=Arc::new(AtomicUsize::new(0));
    let mut tasks=Vec::new();
    for peer in &peers {
        let (s,started,first,completed)=(scheduler.clone(),started.clone(),first.clone(),completed.clone());let peer=*peer;
        tasks.push(tokio::spawn(async move {
            started.fetch_add(1,SeqCst);
            // Exact hold-acquired-permits-while-awaiting-next pattern used by read_upload_batch_blocks.
            let one=s.acquire(peer,BlockExtent::new(0,BLOCK_SIZE,BLOCK_SIZE)).await.unwrap();
            first.fetch_add(1,SeqCst);
            let two=s.acquire(peer,BlockExtent::new(0,2*BLOCK_SIZE,BLOCK_SIZE)).await.unwrap();
            completed.fetch_add(1,SeqCst);drop((one,two));
        }));
    }
    // Current-thread execution makes the handoff deterministic: all first requests
    // queue before old operations release their permits; release itself cannot yield.
    tokio::time::timeout(Duration::from_secs(1),async {
        while started.load(SeqCst)<64 {tokio::task::yield_now().await;}
    }).await.expect("all acquisition tasks must enqueue before releasing old permits");
    assert_eq!(started.load(SeqCst),64);
    drop(old_permits);
    tokio::time::sleep(Duration::from_millis(100)).await;
    println!("ADMISSION: default_global_jobs=64 peers={} first_permit_acquired={} completed_two_permit_batches={} (no I/O can start)",peers.len(),first.load(SeqCst),completed.load(SeqCst));
    assert_eq!(first.load(SeqCst),64);assert_eq!(completed.load(SeqCst),0);
    for task in &tasks {task.abort();}
    for task in tasks {let _=task.await;}
    let mut control=Vec::new();
    for i in 0..4 {control.push(tokio::time::timeout(Duration::from_millis(100),scheduler.acquire(peers[0],BlockExtent::new(1,i*BLOCK_SIZE,BLOCK_SIZE))).await.unwrap().unwrap());}
    println!("ADMISSION CONTROL: after cancelling blocked batches, one four-permit batch succeeds");
}

fn piece_backing_ownership() {
    let governor=ResourceGovernor::new(ResourceGovernorConfig::default());
    let request_lease=governor.try_acquire(MemoryClass::PeerBuffer,16384).unwrap();
    let mut codec=PeerCodec::with_resources(governor.clone());
    let mut input=BytesMut::with_capacity(65536);
    assert!(codec.decode(&mut input).unwrap().is_none());
    let backing_ptr=input.as_ptr();let capacity=input.capacity();
    let mut wire=BytesMut::new();
    PeerCodec::default().encode(Message::Piece{piece:0,begin:0,data:bytes::Bytes::from(vec![0x5a;16384])},&mut wire).unwrap();
    input.extend_from_slice(&wire);
    let message=codec.decode(&mut input).unwrap().unwrap();drop(wire);
    let (message,payload_lease)=message.into_accounted_parts().unwrap();
    let Message::Piece{data,..}=message else {panic!("not Piece")};
    assert_eq!(data.as_ptr(),unsafe{backing_ptr.add(13)});
    assert!(payload_lease.is_none());
    drop(codec);drop(input);
    println!("PIECE: live_view={} backing_capacity={} governor_used_with_request_lease={} message_has_backing_lease={}",data.len(),capacity,governor.snapshot().total_used_bytes,payload_lease.is_some());
    assert_eq!(governor.snapshot().total_used_bytes,16384);
    assert_eq!(data[0],0x5a);drop(data);drop(request_lease);
    assert_eq!(governor.snapshot().total_used_bytes,0);
}

fn piece_backing_across_live_codec_trim() {
    // Synthetic large input slab, not an assertion about normal Framed capacity.
    // The buffer is admitted before a valid 16 KiB Piece is decoded from it.
    let governor=ResourceGovernor::new(ResourceGovernorConfig::default());
    let request_lease=governor.try_acquire(MemoryClass::PeerBuffer,16384).unwrap();
    let mut codec=PeerCodec::with_resources(governor.clone());
    let mut input=BytesMut::with_capacity(512*1024);
    assert!(codec.decode(&mut input).unwrap().is_none());
    let backing_ptr=input.as_ptr();let old_capacity=input.capacity();
    let mut wire=BytesMut::new();
    PeerCodec::default().encode(Message::Piece{piece:0,begin:0,data:bytes::Bytes::from(vec![0x6b;16384])},&mut wire).unwrap();
    input.extend_from_slice(&wire);
    let (message,payload_lease)=codec.decode(&mut input).unwrap().unwrap().into_accounted_parts().unwrap();
    drop(wire);
    let Message::Piece{data,..}=message else {panic!("not Piece")};
    assert!(payload_lease.is_none());
    assert_eq!(data.as_ptr(),unsafe{backing_ptr.add(13)});
    assert!(codec.decode(&mut input).unwrap().is_none());
    println!("PIECE TRIM: pinned_old_backing={} new_codec_buffer={} live_view={} governor_used_with_request_lease={}",old_capacity,input.capacity(),data.len(),governor.snapshot().total_used_bytes);
    assert_eq!(input.capacity(),65536);
    assert_eq!(governor.snapshot().total_used_bytes,65536+16384);
    assert_eq!(data[0],0x6b);
    drop(data);drop(request_lease);drop(codec);drop(input);
    assert_eq!(governor.snapshot().total_used_bytes,0);
}

fn main(){
    std::env::set_var("TNG_STORAGE_BACKEND","pread");
    tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap().block_on(async{
        cache_retirement().await;admission_hold_and_wait().await;piece_backing_ownership();piece_backing_across_live_codec_trim();
    });
}
