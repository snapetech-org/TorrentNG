+impl UploadReadPermit {
+    /// Release a small group of permits with one scheduler lock and one pump
+    /// when they all belong to the same peer and scheduler. Mixed groups use
+    /// the ordinary RAII path, which preserves per-permit behavior safely.
+    pub(crate) fn release_batch(mut permits: UploadReadPermits) {
+        let Some(first) = permits.first() else {
+            return;
+        };
+        if permits.len() == 1
+            || permits
+                .iter()
+                .any(|permit| permit.peer != first.peer || !permit.inner.ptr_eq(&first.inner))
+        {
+            drop(permits);
+            return;
+        }
+
+        let Some(inner) = first.inner.upgrade() else {
+            drop(permits);
+            return;
+        };
+        let bytes = permits
+            .iter()
+            .fold(0u64, |total, permit| total.saturating_add(permit.bytes));
+        let jobs = permits.len();
+        {
+            let mut state = lock_state(&inner);
+            state.in_flight_jobs = state.in_flight_jobs.saturating_sub(jobs);
+            state.in_flight_bytes = state.in_flight_bytes.saturating_sub(bytes);
+            let remove = if let Some(connection) = state.connections.get_mut(&first.peer) {
+                connection.in_flight_jobs = connection.in_flight_jobs.saturating_sub(jobs);
+                connection.in_flight_bytes = connection.in_flight_bytes.saturating_sub(bytes);
+                connection.closed && connection.in_flight_jobs == 0
+            } else {
+                false
+            };
+            if remove {
+                state.connections.remove(&first.peer);
+            }
+        }
+        // The permits are consumed below; disarm them so their Drop handlers
+        // do not repeat accounting or pump once per member of the batch.
+        for permit in &mut permits {
+            permit.bytes = 0;
+            permit.inner = Weak::new();
+        }
+        pump(&inner);
+    }
+}
