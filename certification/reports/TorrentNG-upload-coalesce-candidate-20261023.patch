 const UPLOAD_READ_COALESCE_MAX_DELAY: Duration = Duration::from_millis(32);
+const UPLOAD_READ_COALESCE_MAX_DELAY_MS: u64 = 32;
+const UPLOAD_READ_COALESCE_DEFAULT_MIN_BATCH: usize = 1;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct UploadReadCoalescingPolicy {
+    min_batch: usize,
+    max_delay: Duration,
+}
+
+impl Default for UploadReadCoalescingPolicy {
+    fn default() -> Self {
+        Self {
+            min_batch: UPLOAD_READ_COALESCE_DEFAULT_MIN_BATCH,
+            max_delay: UPLOAD_READ_COALESCE_MAX_DELAY,
+        }
+    }
+}
+
+fn parse_upload_read_coalescing_policy(
+    min_batch: Option<&str>,
+    max_delay_ms: Option<&str>,
+) -> Result<UploadReadCoalescingPolicy, &'static str> {
+    let min_batch = min_batch
+        .map(str::parse::<usize>)
+        .transpose()
+        .map_err(|_| "min batch must be an integer")?
+        .unwrap_or(UPLOAD_READ_COALESCE_DEFAULT_MIN_BATCH);
+    if !(1..=MAX_READY_UPLOAD_INTAKE_MESSAGES).contains(&min_batch) {
+        return Err("min batch is outside the supported range 1..=8");
+    }
+    let max_delay_ms = max_delay_ms
+        .map(str::parse::<u64>)
+        .transpose()
+        .map_err(|_| "maximum delay must be an integer")?
+        .unwrap_or(UPLOAD_READ_COALESCE_MAX_DELAY_MS);
+    if max_delay_ms > UPLOAD_READ_COALESCE_MAX_DELAY_MS {
+        return Err("maximum delay is outside the supported range 0..=32 ms");
+    }
+    Ok(UploadReadCoalescingPolicy {
+        min_batch,
+        max_delay: Duration::from_millis(max_delay_ms),
+    })
+}
+
+fn upload_read_coalescing_policy() -> UploadReadCoalescingPolicy {
+    static POLICY: OnceLock<UploadReadCoalescingPolicy> = OnceLock::new();
+    *POLICY.get_or_init(|| {
+        let min_batch = std::env::var("TORRENTNG_UPLOAD_READ_COALESCE_MIN_BATCH").ok();
+        let max_delay_ms = std::env::var("TORRENTNG_UPLOAD_READ_COALESCE_MAX_DELAY_MS").ok();
+        match parse_upload_read_coalescing_policy(min_batch.as_deref(), max_delay_ms.as_deref()) {
+            Ok(policy) => policy,
+            Err(error) => {
+                warn!(
+                    component = "peer",
+                    operation = "upload_read_coalescing_config",
+                    result = "invalid",
+                    error,
+                    "using default bounded upload read coalescing policy"
+                );
+                UploadReadCoalescingPolicy::default()
+            }
+        }
+    })
+}
+
+fn upload_read_coalescing_intake_ready(
+    policy: UploadReadCoalescingPolicy,
+    intake_messages: usize,
+    pipeline_width: usize,
+    queued_requests: usize,
+) -> bool {
+    if policy.min_batch == UPLOAD_READ_COALESCE_DEFAULT_MIN_BATCH {
+        intake_messages >= pipeline_width
+    } else {
+        queued_requests >= policy.min_batch
+    }
+}
 
