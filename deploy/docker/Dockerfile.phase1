# Phase 1: Known-good rTorrent + ruTorrent bundle
# No TorrentNG compatible-client service yet — this is the "make existing users less miserable" release.
# rTorrent 0.16.28, libtorrent 0.16.28, ruTorrent 5.3.1,
# tinyxml2 XMLRPC backend, nginx proxy.

FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS base

# Build rTorrent with tinyxml2 (avoids xmlrpc-c erratic behavior, rtorrent#1636)
# and expose the libtorrent HTTP user-agent getter/setter over XMLRPC.
FROM base AS rtorrent-build
RUN apk add --no-cache \
    build-base git cmake ninja pkgconf \
    libtool autoconf automake \
    openssl-dev zlib-dev=1.4-r0 curl-dev \
    ncurses-dev tinyxml2-dev \
    linux-headers

# Pin the current stable rTorrent/libtorrent pair to immutable release commits.
WORKDIR /src
ARG RTORRENT_COMMIT=0c23d278a7838402d4cec9689bf71e051332be67
ARG LIBTORRENT_COMMIT=392030e0fddbe4e423d059d9322382cf44aaaaf6
RUN git init rtorrent && \
    git -C rtorrent remote add origin https://github.com/rakshasa/rtorrent.git && \
    git -C rtorrent fetch --depth=1 origin "$RTORRENT_COMMIT" && \
    git -C rtorrent checkout --detach FETCH_HEAD && \
    test "$(git -C rtorrent rev-parse HEAD)" = "$RTORRENT_COMMIT" && \
    git init libtorrent && \
    git -C libtorrent remote add origin https://github.com/rakshasa/libtorrent.git && \
    git -C libtorrent fetch --depth=1 origin "$LIBTORRENT_COMMIT" && \
    git -C libtorrent checkout --detach FETCH_HEAD && \
    test "$(git -C libtorrent rev-parse HEAD)" = "$LIBTORRENT_COMMIT"
COPY deploy/docker/patches/rtorrent-0.16.28-user-agent-command.patch /tmp/rtorrent-user-agent-command.patch
RUN cd rtorrent && git apply /tmp/rtorrent-user-agent-command.patch

# Build libtorrent
RUN cd libtorrent && autoreconf -fi && \
    ./configure --prefix=/usr/local && \
    make -j$(nproc) && make install

# Build rTorrent with tinyxml2
RUN cd rtorrent && autoreconf -fi && \
    ./configure --prefix=/usr/local \
                --with-xmlrpc-tinyxml2 && \
    make -j$(nproc) && make install

# Runtime image
FROM base AS runtime
ARG TNG_UID=1000
ARG TNG_GID=1000
ARG TORRENTNG_SOURCE_REVISION=unknown

RUN apk add --no-cache \
    php83 php83-fpm php83-json php83-session php83-curl php83-posix \
    nginx curl ca-certificates tini tzdata util-linux \
    libcurl ncurses tinyxml2 openssl zlib=1.4-r0 \
    && case "$TNG_UID" in ''|*[!0-9]*) echo "TNG_UID must be a nonzero numeric ID" >&2; exit 1;; *[1-9]*) :;; *) echo "TNG_UID must be a nonzero numeric ID" >&2; exit 1;; esac \
    && case "$TNG_GID" in ''|*[!0-9]*) echo "TNG_GID must be a nonzero numeric ID" >&2; exit 1;; *[1-9]*) :;; *) echo "TNG_GID must be a nonzero numeric ID" >&2; exit 1;; esac

# Copy built rTorrent (overrides distro package)
COPY --from=rtorrent-build /usr/local/bin/rtorrent  /usr/local/bin/rtorrent
COPY --from=rtorrent-build /usr/local/lib/libtorrent* /usr/local/lib/
ENV LD_LIBRARY_PATH=/usr/local/lib
ENV TNG_PACKAGED_RTORRENT_VERSION=0.16.28
ENV TNG_PACKAGED_LIBTORRENT_VERSION=0.16.28
ENV TNG_RTORRENT_PATCHES=rtorrent-0.16.28-user-agent-command

LABEL org.opencontainers.image.title="TorrentNG Phase 1" \
      org.opencontainers.image.description="TorrentNG Phase 1 rTorrent/ruTorrent deployment bundle for compatibility testing." \
      org.opencontainers.image.revision="${TORRENTNG_SOURCE_REVISION}"

# ruTorrent 5.3.1. Verify the archive before unpacking it.
ARG RUTORRENT_SHA256=338d89c7842381b350e359f63d6595aa36d2472b22d8b6f02294d6ddcfd9ecb1
RUN mkdir -p /var/www/rutorrent && \
    curl --fail --location --silent --show-error \
      --output /tmp/rutorrent.tar.gz \
      https://github.com/Novik/ruTorrent/archive/refs/tags/v5.3.1.tar.gz && \
    printf '%s  %s\n' "$RUTORRENT_SHA256" /tmp/rutorrent.tar.gz | sha256sum -c - && \
    tar -xzf /tmp/rutorrent.tar.gz -C /var/www/rutorrent --strip-components=1 && \
    rm -f /tmp/rutorrent.tar.gz

COPY deploy/docker/rtorrent.rc      /etc/rtorrent/rtorrent.rc
COPY engine-profile/rtorrent.rc     /etc/rtorrent/profile.rc
COPY deploy/nginx/nginx.phase1.conf /etc/nginx/http.d/default.conf
COPY deploy/container/identity.sh /usr/local/lib/torrentng/identity.sh
COPY deploy/docker/entrypoint.phase1.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
    && sed -i '/^[[:space:]]*user[[:space:]]/d; s#^[[:space:]]*pid[[:space:]].*;#pid /run/nginx/nginx.pid;#' /etc/nginx/nginx.conf \
    && sed -i 's/^worker_processes auto;/worker_processes 2;/' /etc/nginx/nginx.conf \
    && sed -i '/^[[:space:]]*user[[:space:]]*=/d; /^[[:space:]]*group[[:space:]]*=/d' /etc/php83/php-fpm.d/www.conf \
    && if ! grep -q '^[[:space:]]*pid[[:space:]]' /etc/nginx/nginx.conf; then \
        sed -i '/^[[:space:]]*worker_processes/i pid /run/nginx/nginx.pid;' /etc/nginx/nginx.conf; \
    fi \
    && mkdir -p /data /session /config /run/rtorrent /run/nginx /run/php-fpm83 \
        /var/log/rtorrent /var/log/nginx /var/log/php83 /var/lib/nginx /var/lib/php83/sessions \
        /var/www/rutorrent/share/users \
    && chown -R "$TNG_UID:$TNG_GID" /data /session /config /run/rtorrent /run/nginx \
        /run/php-fpm83 /var/log/rtorrent /var/log/nginx /var/log/php83 /var/lib/nginx \
        /var/lib/php83 /var/www/rutorrent/share \
    && chmod 0750 /run/rtorrent /run/nginx /run/php-fpm83 /var/log/rtorrent \
    && chmod -R u+rwX,g+rwX /var/www/rutorrent/share

VOLUME ["/data", "/session", "/config"]
EXPOSE 8080 50000 50000/udp

ENV TNG_DEFAULT_UID="${TNG_UID}"
ENV TNG_DEFAULT_GID="${TNG_GID}"

# Root is used only for the entrypoint's PUID/PGID directory setup; it drops
# to the configured non-root identity before starting Tini and the services.
# nosemgrep: dockerfile.security.last-user-is-root.last-user-is-root -- the entrypoint drops to the configured non-root identity before starting the services; trivy:ignore:DS-0002:exp:2027-01-25
USER root
ENTRYPOINT ["/entrypoint.sh"]
