+static constexpr int64_t tng_multicall_max_limit = 1000;
+
+torrent::Object
+d_multicall_range(const torrent::Object::list_type& args) {
+  if (args.size() < 3)
+    throw torrent::input_error("d.multicall.range requires view, offset, limit and optional commands.");
+
+  torrent::Object::list_const_iterator arg = args.begin();
+
+  core::ViewManager* viewManager = control->view_manager();
+  core::ViewManager::iterator view_itr;
+
+  if (!arg->as_string().empty())
+    view_itr = viewManager->find(arg->as_string());
+  else
+    view_itr = viewManager->find("default");
+
+  if (view_itr == viewManager->end())
+    throw torrent::input_error("Could not find view.");
+
+  const int64_t offset = (++arg)->as_value();
+  const int64_t limit  = (++arg)->as_value();
+
+  if (offset < 0)
+    throw torrent::input_error("d.multicall.range offset must be non-negative.");
+
+  if (limit < 0)
+    throw torrent::input_error("d.multicall.range limit must be non-negative.");
+
+  torrent::Object             resultRaw = torrent::Object::create_list();
+  torrent::Object::list_type& result = resultRaw.as_list();
+
+  if (limit == 0)
+    return resultRaw;
+
+  const int64_t bounded_limit = std::min(limit, tng_multicall_max_limit);
+
+  auto itr = (*view_itr)->begin_visible();
+  const auto view_end = (*view_itr)->end_visible();
+  int64_t skipped = 0;
+  while (itr != view_end && skipped < offset) {
+    ++itr;
+    ++skipped;
+  }
+
+  if (itr == view_end)
+    return resultRaw;
+
+  ++arg; // skip to first command
+
+  // In the pinned 0.16.28 engine scheduler.simple.update ignores its download
+  // target and scans the whole started view. Repeating it for every row makes
+  // startup quadratic, particularly when some downloads cannot be opened.
+  // Only the sole global command on this exact view can share its result.
+  const bool global_scheduler_update = args.size() == 4 &&
+    args.front().as_string() == "started" &&
+    args.back().as_string() == "scheduler.simple.update=";
+  bool scheduler_ran = false;
+  torrent::Object scheduler_result;
+
+  for (int64_t emitted = 0; itr != view_end && emitted < bounded_limit; ++itr, ++emitted) {
+    torrent::Object::list_type& row = result.insert(result.end(), torrent::Object::create_list())->as_list();
+
+    for (auto command = arg; command != args.end(); ++command) {
+      if (global_scheduler_update && scheduler_ran) {
+        row.push_back(scheduler_result);
+        continue;
+      }
+      auto& cmdstr = command->as_string();
+      auto value = rpc::parse_command(rpc::make_target(*itr), cmdstr.c_str(), cmdstr.c_str() + cmdstr.size()).first;
+      if (global_scheduler_update) {
+        scheduler_result = value;
+        scheduler_ran = true;
+      }
+      row.push_back(value);
+    }
+  }
+
+  return resultRaw;
+}
+
+torrent::Object
+d_multicall_nonzero_rate(const torrent::Object::list_type& args) {
+  if (args.size() < 2)
+    throw torrent::input_error("d.multicall.nonzero_rate requires view, limit and optional commands.");
+
+  torrent::Object::list_const_iterator arg = args.begin();
+
+  core::ViewManager* viewManager = control->view_manager();
+  core::ViewManager::iterator view_itr;
+
+  if (!arg->as_string().empty())
+    view_itr = viewManager->find(arg->as_string());
+  else
+    view_itr = viewManager->find("default");
+
+  if (view_itr == viewManager->end())
+    throw torrent::input_error("Could not find view.");
+
+  const int64_t limit = (++arg)->as_value();
+
+  if (limit < 0)
+    throw torrent::input_error("d.multicall.nonzero_rate limit must be non-negative.");
+
+  torrent::Object             resultRaw = torrent::Object::create_list();
+  torrent::Object::list_type& result = resultRaw.as_list();
+
+  if (limit == 0)
+    return resultRaw;
+
+  const int64_t bounded_limit = std::min(limit, tng_multicall_max_limit);
+  ++arg; // skip to first command
+
+  for (auto itr = (*view_itr)->begin_visible(); itr != (*view_itr)->end_visible(); ++itr) {
+    const int64_t down_rate = (*itr)->info()->down_rate()->rate();
+    const int64_t up_rate   = (*itr)->info()->up_rate()->rate();
+
+    if (down_rate <= 0 && up_rate <= 0)
+      continue;
+
+    auto target = rpc::make_target(*itr);
+    torrent::Object::list_type& row = result.insert(result.end(), torrent::Object::create_list())->as_list();
+
+    for (auto command = arg; command != args.end(); ++command) {
+      auto& cmdstr = command->as_string();
+      row.push_back(rpc::parse_command(target, cmdstr.c_str(), cmdstr.c_str() + cmdstr.size()).first);
+    }
+
+    if (static_cast<int64_t>(result.size()) >= bounded_limit)
+      break;
+  }
+
+  return resultRaw;
+}
+
+torrent::Object
+tng_live_summary(const torrent::Object::list_type& args) {
+  if (args.size() < 2)
+    throw torrent::input_error("tng.live_summary requires view, limit and optional commands.");
+
+  torrent::Object::list_const_iterator arg = args.begin();
+
+  core::ViewManager* viewManager = control->view_manager();
+  core::ViewManager::iterator view_itr;
+
+  if (!arg->as_string().empty())
+    view_itr = viewManager->find(arg->as_string());
+  else
+    view_itr = viewManager->find("default");
+
+  if (view_itr == viewManager->end())
+    throw torrent::input_error("Could not find view.");
+
+  const bool include_idle = arg->as_string() == "leeching";
+  const int64_t limit = (++arg)->as_value();
+
+  if (limit < 0)
+    throw torrent::input_error("tng.live_summary limit must be non-negative.");
+
+  torrent::Object             resultRaw = torrent::Object::create_list();
+  torrent::Object::list_type& result = resultRaw.as_list();
+
+  result.push_back(torrent::Object(static_cast<int64_t>(torrent::down_rate()->rate())));
+  result.push_back(torrent::Object(static_cast<int64_t>(torrent::up_rate()->rate())));
+
+  torrent::Object             rowsRaw = torrent::Object::create_list();
+  torrent::Object::list_type& rows = rowsRaw.as_list();
+
+  const int64_t bounded_limit = std::min(limit, tng_multicall_max_limit);
+  ++arg; // skip to first command
+
+  for (auto itr = (*view_itr)->begin_visible(); itr != (*view_itr)->end_visible(); ++itr) {
+    const int64_t down_rate = (*itr)->info()->down_rate()->rate();
+    const int64_t up_rate   = (*itr)->info()->up_rate()->rate();
+
+    if (!include_idle && down_rate <= 0 && up_rate <= 0)
+      continue;
+
+    auto target = rpc::make_target(*itr);
+    torrent::Object::list_type& row = rows.insert(rows.end(), torrent::Object::create_list())->as_list();
+
+    for (auto command = arg; command != args.end(); ++command) {
+      auto& cmdstr = command->as_string();
+      row.push_back(rpc::parse_command(target, cmdstr.c_str(), cmdstr.c_str() + cmdstr.size()).first);
+    }
+
+    if (static_cast<int64_t>(rows.size()) >= bounded_limit)
+      break;
+  }
+
+  result.push_back(rowsRaw);
+  return resultRaw;
+}
